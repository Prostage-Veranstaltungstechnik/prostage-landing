# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=prostage
MYSQL_USER=prostage
MYSQL_PASSWORD=change-me
# Alternativ: DATABASE_URL=mysql://prostage:change-me@127.0.0.1:3306/prostage
# MYSQL_SSL=false

# Admin: SESSION_SECRET muss mindestens 32 Zeichen lang und zufällig sein.
ADMIN_PASSWORD=change-this-admin-password
ADMIN_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer@example.com
SMTP_PASSWORD=change-me
MAIL_FROM=ProStage Website <mailer@example.com>
SALES_EMAIL=sales@prostage.de
INFO_EMAIL=info@prostage.de

# Produktbilder
DATA_PATH=/data
